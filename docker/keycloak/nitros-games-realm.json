{
  "realm": "nitros-games",
  "displayName": "Nitros Games",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "May mutate Nitros Games resources"
      }
    ]
  },
  "clients": [
    {
      "clientId": "nitros-games-api",
      "name": "Nitros Games API",
      "protocol": "openid-connect",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false
    },
    {
      "clientId": "nitros-games-web",
      "name": "Nitros Games Web",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "protocolMappers": [
        {
          "name": "nitros-games-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "nitros-games-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "nitros-games-cli",
      "name": "Nitros Games CLI demo",
      "description": "Development-only client for obtaining an ADMIN token",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "secret": "${NITROS_GAMES_CLI_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "nitros-games-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "nitros-games-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-nitros-games-cli",
      "enabled": true,
      "serviceAccountClientId": "nitros-games-cli",
      "realmRoles": [
        "ADMIN"
      ]
    }
  ]
}
