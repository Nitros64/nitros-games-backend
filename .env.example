SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:mysql://localhost:3306/nitrosgames?createDatabaseIfNotExist=true&sslMode=DISABLED&allowPublicKeyRetrieval=true
DB_USERNAME=nitros
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=replace-with-a-different-random-password
FLYWAY_BASELINE_ON_MIGRATE=true
APP_PORT=8080
APP_MEMORY_LIMIT=768m
APP_LOG_LEVEL=INFO
MYSQL_MEMORY_LIMIT=1g
KEYCLOAK_PORT=8081
KEYCLOAK_MEMORY_LIMIT=768m
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-password
NITROS_GAMES_CLI_SECRET=replace-with-another-long-random-secret
APP_STORAGE_HOST_IMAGES_DIRECTORY=uploadImageFileHost
APP_STORAGE_MAX_FILE_SIZE=10MB
APP_STORAGE_MAX_REQUEST_SIZE=11MB
APP_SECURITY_ALLOWED_ORIGINS=http://localhost:4200
OAUTH2_ISSUER_URI=http://localhost:8081/realms/nitros-games
OAUTH2_JWK_SET_URI=http://keycloak:8080/realms/nitros-games/protocol/openid-connect/certs
OAUTH2_AUDIENCE=nitros-games-api
